# Copy to .env.local for local development.
FRONTEND_PORT=3000
FRONTEND_HOSTNAME=0.0.0.0
BACKEND_URL=http://127.0.0.1:8484
BFF_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_KARAVAN_URL=http://localhost:8081
NEXT_PUBLIC_HAWTIO_URL=https://camel.hawt.io/online/login?redirectUri=http%3A%2F%2Fcamel.hawt.io%2Fonline%2F

AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-here
KEYCLOAK_CLIENT_ID=routeforge-client
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/routeforge
KEYCLOAK_HTTP_TIMEOUT_MS=15000

# Portfolio demo: skip auth redirects so the UI is browsable without Keycloak.
# Set to true on Render/Vercel when no auth backend is available.
DEMO_MODE=false
